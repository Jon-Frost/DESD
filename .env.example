# Required database settings (used by docker-compose + Django)
POSTGRES_DB=desd_db
POSTGRES_USER=desd_user
POSTGRES_PASSWORD=desd_password
DB_HOST=db
DB_PORT=5432

# Optional: Cloudinary media storage
# Leave blank for local file storage (recommended for tutor marking)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Optional: Stripe test checkout
# Leave blank to use local non-Stripe checkout fallback
STRIPE_PUBLISHABLE_KEY=
STRIPE_SECRET_KEY=

# Optional app settings
SECRET_KEY=django-insecure-local-dev-only
POSTCODE_API_BASE_URL=https://api.postcodes.io
POSTCODE_API_TIMEOUT=5
LOGIN_RATE_LIMIT_ATTEMPTS=3
LOGIN_RATE_LIMIT_WINDOW_SECONDS=900

# Optional Celery settings
CELERY_BROKER_URL=redis://redis:6379/0
CELERY_RESULT_BACKEND=redis://redis:6379/0
